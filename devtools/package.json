{
  "name": "@pinia/colada-devtools",
  "type": "module",
  "version": "1.1.2",
  "description": "Devtools for Pinia Colada",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Eduardo San Martin Morote",
    "email": "posva13@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/posva",
  "homepage": "https://github.com/posva/pinia-colada#readme",
  "repository": "posva/pinia-colada",
  "bugs": {
    "url": "https://github.com/posva/pinia-colada/issues"
  },
  "keywords": [
    "pinia",
    "plugin",
    "data",
    "fetching",
    "query",
    "mutation",
    "cache",
    "layer"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./panel": "./dist-panel/index.js",
    "./shared": "./dist-shared/index.js",
    "./devframe": "./dist-devframe/index.js",
    "./devframe/vite": "./dist-devframe/vite.js",
    "./devframe/vite-hub": "./dist-devframe/vite-hub.js",
    "./devframe/client-script": "./dist-devframe/client-script.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "dist-panel",
    "dist-shared",
    "dist-devframe"
  ],
  "scripts": {
    "dev:app": "vite",
    "dev:db": "pnpm run -C ../playground dev:db",
    "dev": "pnpm run --stream '/^dev:/'",
    "test:types": "vue-tsc --noEmit",
    "build:main": "vite build --config vite.config.ts",
    "build:shared": "vite build --config vite.config.shared.ts",
    "build:panel": "vite build --config vite.config.panel.ts",
    "build:devframe": "tsdown --config devframe/tsdown.config.ts && vite build --config devframe/client/vite.config.ts",
    "build": "pnpm run --stream '/^build:(main|shared|panel)$/' && pnpm run build:devframe"
  },
  "dependencies": {
    "@devframes/hub-ui": "^0.9.7",
    "@devframes/vite": "^0.9.7",
    "@modelcontextprotocol/server": "^2.0.0",
    "devframe": "^0.9.8"
  },
  "peerDependencies": {
    "@vitejs/devtools-kit": "^0.5.2 || ^0.6.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/devtools-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.125",
    "@microsoft/api-extractor": "^7.59.0",
    "@pinia/colada": "workspace:^*",
    "@posva/splitpanes": "^4.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/devtools-kit": "^0.6.1",
    "@vueuse/core": "^14.4.0",
    "mande": "^2.0.10",
    "match-container": "^0.1.4",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "unplugin-dts": "^1.0.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.11"
  }
}
