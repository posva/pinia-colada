{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "noEmit": true,
    "module": "esnext",
    "target": "esnext",
    "skipLibCheck": true,
    "lib": ["esnext", "dom"],
    "moduleResolution": "Bundler",
    "paths": {
      "@pinia/colada-devtools/shared": ["./src/shared/index.ts"],
      "@pinia/colada-devtools/devframe": ["./src/index.ts"],
      "@pinia/colada-devtools/devframe/vite": ["./src/vite.ts"],
      "@pinia/colada-devtools/devframe/vite-hub": ["./src/vite-hub.ts"],
      "@pinia/colada-devtools/devframe/client-script": ["./src/client-script.ts"]
    },
    "types": ["unplugin-icons/types/vue"]
  },
  "include": [
    "./src/**/*",
    "./env.d.ts",
    "./components.d.ts",
    "./typed-router.d.ts",
    "./vite.config.*",
    "./panel.vite.config.ts",
    "./package.json"
  ],
  "vueCompilerOptions": {
    "plugins": ["vue-router/volar/sfc-route-blocks", "vue-router/volar/sfc-typed-router"]
  }
}
