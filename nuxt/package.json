{
  "name": "@pinia/colada-nuxt",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "version": "1.0.2",
  "description": "Pinia Colada Nuxt module",
  "license": "MIT",
  "repository": "posva/pinia-colada",
  "homepage": "https://pinia-colada.esm.dev/nuxt.html",
  "exports": {
    ".": "./dist/module.mjs"
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "peerDependencies": {
    "@pinia/colada": "workspace:>="
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@pinia/colada": "workspace:*",
    "@pinia/nuxt": "^1.0.2",
    "nuxi": "^3.37.0",
    "nuxt": "^4.5.2",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "overrides": {
      "@nuxt/devtools": "npm:@nuxt/devtools-nightly@latest"
    }
  }
}
